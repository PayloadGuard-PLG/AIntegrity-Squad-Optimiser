{
  "expo": {
    "name": "AIntegrity Squad Optimiser",
    "slug": "squad-optimiser",
    "version": "1.0.0",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "package": "com.payloadguard.squadoptimiser"
    },
    "ios": {
      "bundleIdentifier": "com.payloadguard.squadoptimiser"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      ["expo-image-picker", {
        "photosPermission": "Allow Squad Optimiser to access your photo library to scan player card and coaching session screenshots."
      }]
    ],
    "updates": {
      "url": "https://u.expo.dev/5e2319b8-dda7-4fbf-9fb4-5918d690d476"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5e2319b8-dda7-4fbf-9fb4-5918d690d476"
      }
    },
    "owner": "sdarkvader"
  }
}
